                        'table' => 'companies',
                        'type' => 'LEFT',
                        'conditions' => 'Attendees.company_id = `company`.`id`'
                    ],
                    'conditions' => [
                        'Attendees.meeting_id' => $latest_meeting->id,
                        'Attendees.astatus <>' => 'D',
