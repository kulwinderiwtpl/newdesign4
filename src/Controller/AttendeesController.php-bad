            $arrid[] = $aid->attendee_id;
        }
        if (!empty($arrid)) {
            $idss = implode(",", $arrid);
        }else{
            $idss="";
        }
        if($idss!==""){
        $latest_attendees = $this->Attendees->find('all', [
                    //'contain'=>['InvoiceDetails'],
